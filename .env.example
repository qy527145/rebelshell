# RebelShell 本机开发配置模板。
#
# 用法：
#   cp .env.example .env      # 然后按需修改；.env 已被 gitignore
#
# 读取方式有两层，任一都能让配置生效：
#   1. bun 脚本：`bun run --env-file=.env` 显式加载（bun 本身也会自动读仓库根的 .env），
#      变量注入 turbo 任务；turbo.json 已设 envMode=loose，不会再过滤掉它们。
#   2. Rust 二进制：启动时自己向上查找 .env 并补齐缺失的变量（见各自的 envfile.rs），
#      所以 `cargo run`、直接跑 target/release 下的可执行文件同样能读到这份配置。
# 优先级：命令行参数 > 已存在的环境变量 > .env > 代码里的默认值。
# build / test / lint 不需要这里的配置，也不会因此改变行为。

# ── Server ────────────────────────────────────────────────────────────
# 全局管理令牌：Web 端登录与所有 API / WebSocket 鉴权都用它。
# 留空或使用默认值时服务端会在日志里告警，别在能被别人访问的网络上这么干。
ADMIN_TOKEN=dev

# 唯一的监听端口：Web 界面与虚拟机客户端的反向连接共用它。
#
# 服务端按「首帧」分流：客户端的首帧一定是 `REGISTER:…`，浏览器的一定是
# `GET /` 之类的方法行，两者不会混淆。因此内网策略只需要放行这一个端口。
PORT=8080

# 绑定地址。默认 0.0.0.0 表示监听所有网卡 —— 虚拟机要能出站连过来，
# 所以通常不能只绑 127.0.0.1。
BIND_ADDR=0.0.0.0

# 命令执行 / 文件传输的等待上限（秒）
COMMAND_TIMEOUT_SECS=60
TRANSFER_TIMEOUT_SECS=300

# 设备列表变化检测与推送间隔（秒）
PUSH_INTERVAL_SECS=3

# 日志过滤，例如 RUST_LOG=rebelshell_server=debug
RUST_LOG=info,tower_http=warn

# ── Client ────────────────────────────────────────────────────────────
# 客户端连的就是上面那个 PORT，改 PORT 时记得同步改这里。地址写 `主机:端口`。
# 客户端与服务端启动时都会从当前目录向上找 .env，找到即用；
# 想把配置固定在别处时用 REBELSHELL_ENV_FILE 指定具体文件。
REBELSHELL_SERVER=127.0.0.1:8080